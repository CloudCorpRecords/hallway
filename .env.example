# Hallway environment. Copy to .env and fill in at the venue. No real secrets in git.

# FalkorDB (Docker: docker compose up -d, or a local redis-server with the FalkorDB module)
FALKORDB_URL=redis://localhost:6379
HALLWAY_GRAPH=hallway

# Bright Data (Track 2). Sign up at brightdata.com, grab an API key, redeem the
# venue credit code from BUILD-PLAN.md at signup. Zones are created in the
# Bright Data dashboard; defaults below match a standard account.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE_WEB_UNLOCKER=web_unlocker1
BRIGHTDATA_ZONE_SERP=serp_api1

# The live conference schedule page Scout keeps fresh. Placeholder until the
# real event schedule URL is known.
SCHEDULE_URL=https://example.com/conference/schedule

# LLM provider for the Python agents (agents/llm.py). Both providers speak
# the OpenAI-compatible chat completions shape; the layer picks base URL,
# key and default model from these. Fireworks is the live default: the
# OpenAI account balance is negative (2026-10-24), so OpenAI is coded and
# mock-tested but not live until that is settled. A key value of "proxy"
# works with the local credential proxies (fw-proxy.py on 127.0.0.1:8791),
# which attach the real key so it never sits in this file.
HALLWAY_LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
HALLWAY_LLM_MODEL=

# OpenAI (Track 3). $50 credits are claimed at the venue; the key lives in
# TrueForge. Used by agents/llm.py when HALLWAY_LLM_PROVIDER=openai, and
# OPENAI_BASE_URL can point it at any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# TrueForge (Track 3, TrueFoundry agent harness).
# The harness is TypeScript first and starts with one command, nothing to
# clone: npx @truefoundry/trueforge. Agent definitions live in trueforge/
# (scout, planner, matchmaker agent.json files, adapted from the TrueForge
# agent cookbook examples). OpenAI is configured as a standard provider in
# TrueForge with the venue key (platform.openai.com/api-keys). The Python
# agents in agents/ are the deterministic fallback; nothing hard-depends on
# the harness being up.
TRUEFORGE_ENABLED=auto

# Bright Data access mode: api (default) or cli (shells out to the bdata CLI:
# npx -p @brightdata/cli bdata login; bdata scrape <url>; bdata search "...").
BRIGHTDATA_MODE=api

# Set to 1 in non-interactive contexts (tests, CI) so approval prompts never block.
HALLWAY_NONINTERACTIVE=
